import MatrixGeneratedCandidate

/-! The actual algebra generated by matrix entries and inverse determinant is
unchanged by an invertible change of basis over the base ring. This does not
construct the arithmetic normal-form matrix or identify analytic functions. -/
noncomputable section
namespace StrictEUnit
variable {B L : Type*} [CommRing B] [Field L] [Algebra B L]
variable {n : Type*} [Fintype n] [DecidableEq n]

theorem matrixGeneratedAlgebra_le_iff (Y : Matrix n n L) (S : Subalgebra B L) :
    matrixGeneratedAlgebra (B := B) Y ≤ S ↔
      Y.det⁻¹ ∈ S ∧ ∀ i j, Y i j ∈ S := by
  rw [matrixGeneratedAlgebra, Algebra.adjoin_le_iff]
  constructor
  · intro h
    exact ⟨h (Set.mem_insert _ _), fun i j => h (Set.mem_insert_of_mem _ ⟨(i,j), rfl⟩)⟩
  · rintro ⟨hd, hY⟩ x (rfl | ⟨⟨i,j⟩, rfl⟩)
    · exact hd
    · exact hY i j

theorem base_matrix_unit_inv_det_mem (S : Subalgebra B L)
    (Z : (Matrix n n B)ˣ) :
    ((Z : Matrix n n B).map (algebraMap B L)).det⁻¹ ∈ S := by
  let d : Bˣ := Units.map Matrix.detMonoidHom Z
  have hd : ((Z : Matrix n n B).map (algebraMap B L)).det = algebraMap B L (d : B) := by
    exact ((algebraMap B L).map_det (Z : Matrix n n B)).symm
  rw [hd]
  have hi : (algebraMap B L (d : B))⁻¹ = algebraMap B L (↑d⁻¹ : B) := by
    have h : algebraMap B L (d : B) * algebraMap B L (↑d⁻¹ : B) = 1 := by
      rw [← map_mul]; simp
    exact inv_eq_of_mul_eq_one_right h
  rw [hi]
  exact S.algebraMap_mem _

theorem matrixGeneratedAlgebra_mul_base_unit_le (Y : Matrix n n L)
    (Z : (Matrix n n B)ˣ) :
    matrixGeneratedAlgebra (B := B) (Y * (Z : Matrix n n B).map (algebraMap B L)) ≤
      matrixGeneratedAlgebra (B := B) Y := by
  apply (matrixGeneratedAlgebra_le_iff _ _).mpr
  constructor
  · rw [Matrix.det_mul, mul_inv_rev]
    exact (matrixGeneratedAlgebra Y).mul_mem
      (base_matrix_unit_inv_det_mem _ Z) (Algebra.subset_adjoin (Set.mem_insert _ _))
  · intro i j
    rw [Matrix.mul_apply]
    apply Subalgebra.sum_mem
    intro l _
    exact (matrixGeneratedAlgebra Y).mul_mem
      (matrixEntryAlgebra_le Y (matrixEntry_mem Y i l))
      ((matrixGeneratedAlgebra Y).algebraMap_mem _)

theorem matrixGeneratedAlgebra_mul_base_unit (Y : Matrix n n L)
    (Z : (Matrix n n B)ˣ) :
    matrixGeneratedAlgebra (B := B) (Y * (Z : Matrix n n B).map (algebraMap B L)) =
      matrixGeneratedAlgebra (B := B) Y := by
  apply le_antisymm (matrixGeneratedAlgebra_mul_base_unit_le Y Z)
  have h := matrixGeneratedAlgebra_mul_base_unit_le
    (Y * (Z : Matrix n n B).map (algebraMap B L)) Z⁻¹
  have hprod : (Y * (Z : Matrix n n B).map (algebraMap B L)) *
      (↑Z⁻¹ : Matrix n n B).map (algebraMap B L) = Y := by
    rw [mul_assoc, ← Matrix.map_mul]
    simp
  rwa [hprod] at h

end StrictEUnit
#print axioms StrictEUnit.matrixGeneratedAlgebra_le_iff
#print axioms StrictEUnit.base_matrix_unit_inv_det_mem
#print axioms StrictEUnit.matrixGeneratedAlgebra_mul_base_unit_le
#print axioms StrictEUnit.matrixGeneratedAlgebra_mul_base_unit
