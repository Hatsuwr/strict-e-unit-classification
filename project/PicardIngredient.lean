import Mathlib.RingTheory.Localization.NumDen
import Mathlib.Algebra.GCDMonoid.Finset
import Mathlib.RingTheory.FractionalIdeal.Operations
import Mathlib.Tactic.Ring

/-!
An algebraic ingredient for Picard triviality: invertible fractional ideals in
a UFD are principal. This does not construct a fractional-ideal realization of
an arbitrary line module, nor prove torsor descent or E-function hypotheses.
-/

noncomputable section

open scoped nonZeroDivisors
open IsLocalization

namespace StrictEUnit

variable {A K : Type*} [CommRing A] [IsDomain A] [UniqueFactorizationMonoid A]
  [Field K] [Algebra A K] [IsFractionRing A K]

/-- If a times a fraction lies in the base ring, the reduced denominator of
that fraction divides a. This is the arithmetic cancellation step used below. -/
theorem reduced_den_dvd_of_integer_mul (a : A) (x : K)
    (h : IsInteger A (algebraMap A K a * x)) :
    (IsFractionRing.den A x : A) ∣ a := by
  obtain ⟨b, hb⟩ := h
  have hx : x * algebraMap A K (IsFractionRing.den A x) =
      algebraMap A K (IsFractionRing.num A x) :=
    IsFractionRing.num_mul_den_eq_num_iff_eq.mpr rfl
  have hcross : a * IsFractionRing.num A x = (IsFractionRing.den A x : A) * b := by
    apply FaithfulSMul.algebraMap_injective A K
    simp only [map_mul]
    rw [hb, ← hx]
    ring
  exact (IsFractionRing.num_den_reduced A x).symm.dvd_of_dvd_mul_right ⟨b, hcross⟩

/-- Conversely, multiplying a fraction by a multiple of its reduced
denominator gives an element of the base ring. -/
theorem integer_mul_of_reduced_den_dvd (a : A) (x : K)
    (h : (IsFractionRing.den A x : A) ∣ a) :
    IsInteger A (algebraMap A K a * x) := by
  obtain ⟨b, rfl⟩ := h
  refine ⟨b * IsFractionRing.num A x, ?_⟩
  have hx : x * algebraMap A K (IsFractionRing.den A x) =
      algebraMap A K (IsFractionRing.num A x) :=
    IsFractionRing.num_mul_den_eq_num_iff_eq.mpr rfl
  simp only [map_mul]
  rw [← hx]
  ring

/-- A primitive finite family detects whether a fraction is in the base ring.
The condition concerns divisibility, not an assumed Bezout identity. -/
theorem integer_of_primitive_integer_products {ι : Type*}
    (s : Finset ι) (a : ι → A)
    (hprimitive : ∀ d : A, (∀ i ∈ s, d ∣ a i) → IsUnit d)
    (x : K) (hproducts : ∀ i ∈ s, IsInteger A (algebraMap A K (a i) * x)) :
    IsInteger A x := by
  apply IsFractionRing.isInteger_of_isUnit_den
  apply hprimitive
  intro i hi
  exact reduced_den_dvd_of_integer_mul (a i) x (hproducts i hi)

/-- An integral ideal with an inverse is generated by the gcd of any finite
generating set. This is a UFD result, not a PID assumption. -/
theorem invertible_integral_ideal_eq_gcd [NormalizedGCDMonoid A]
    (I : Ideal A) (s : Finset A) (hs : Ideal.span (s : Set A) = I)
    (J : FractionalIdeal A⁰ K) (hIJ : (I : FractionalIdeal A⁰ K) * J = 1) :
    (I : FractionalIdeal A⁰ K) =
      FractionalIdeal.spanSingleton A⁰ (algebraMap A K (s.gcd id)) := by
  let g := s.gcd id
  have hIg : I ≤ Ideal.span {g} := by
    rw [← hs, Ideal.span_le]
    intro a ha
    exact Ideal.mem_span_singleton.mpr (Finset.gcd_dvd ha)
  have hIg' : (I : FractionalIdeal A⁰ K) ≤
      FractionalIdeal.spanSingleton A⁰ (algebraMap A K g) := by
    rw [← FractionalIdeal.coeIdeal_span_singleton]
    exact (FractionalIdeal.coeIdeal_le_coeIdeal K).mpr hIg
  have hgJ : FractionalIdeal.spanSingleton A⁰ (algebraMap A K g) * J ≤ 1 := by
    apply FractionalIdeal.spanSingleton_mul_le_iff.mpr
    intro x hx
    apply (FractionalIdeal.mem_one_iff A⁰).mpr
    apply integer_mul_of_reduced_den_dvd
    apply Finset.dvd_gcd
    intro a ha
    apply reduced_den_dvd_of_integer_mul a x
    apply (FractionalIdeal.mem_one_iff A⁰).mp
    rw [← hIJ]
    exact FractionalIdeal.mul_mem_mul
      (FractionalIdeal.mem_coeIdeal_of_mem A⁰ (hs ▸ Ideal.subset_span ha)) hx
  have hback := FractionalIdeal.mul_right_mono (I : FractionalIdeal A⁰ K) hgJ
  have hJI : J * (I : FractionalIdeal A⁰ K) = 1 := by rwa [mul_comm]
  have hback' : FractionalIdeal.spanSingleton A⁰ (algebraMap A K g) ≤
      (I : FractionalIdeal A⁰ K) := by
    simpa only [mul_assoc, hJI, mul_one, one_mul] using hback
  exact le_antisymm hIg' hback'

/-- Every integral ideal that is invertible as a fractional ideal over a UFD
is principal. Finite generation is derived from invertibility. -/
theorem invertible_integral_ideal_isPrincipal (I : Ideal A)
    (hI : IsUnit (I : FractionalIdeal A⁰ K)) : I.IsPrincipal := by
  letI : NormalizedGCDMonoid A := Classical.choice inferInstance
  obtain ⟨s, hs⟩ := Ideal.fg_of_isUnit
    (FaithfulSMul.algebraMap_injective A K) I hI
  obtain ⟨J, hJ⟩ := hI.exists_right_inv
  have heq := invertible_integral_ideal_eq_gcd I s hs J hJ
  rw [← FractionalIdeal.coeIdeal_span_singleton] at heq
  have hIeq : I = Ideal.span {s.gcd id} := FractionalIdeal.coeIdeal_injective heq
  apply (Submodule.isPrincipal_iff I).mpr
  refine ⟨s.gcd id, ?_⟩
  rw [Ideal.submodule_span_eq]
  exact hIeq

/-- The full fractional-ideal form of the UFD ingredient: any invertible
fractional ideal is generated by one element of the fraction field. -/
theorem invertible_fractional_ideal_isPrincipal (I : FractionalIdeal A⁰ K)
    (hI : IsUnit I) : (I : Submodule A K).IsPrincipal := by
  obtain ⟨a, aI, ha, hrep⟩ := FractionalIdeal.exists_eq_spanSingleton_mul I
  have hunit : IsUnit (aI : FractionalIdeal A⁰ K) := by
    rw [hrep] at hI
    exact isUnit_of_mul_isUnit_right hI
  letI : aI.IsPrincipal := invertible_integral_ideal_isPrincipal aI hunit
  obtain ⟨g, hg⟩ := (Submodule.isPrincipal_iff aI).mp inferInstance
  rw [Ideal.submodule_span_eq] at hg
  apply (FractionalIdeal.isPrincipal_iff I).mpr
  refine ⟨(algebraMap A K a)⁻¹ * algebraMap A K g, ?_⟩
  rw [hrep, hg, FractionalIdeal.coeIdeal_span_singleton,
    FractionalIdeal.spanSingleton_mul_spanSingleton]

end StrictEUnit

#print axioms StrictEUnit.reduced_den_dvd_of_integer_mul
#print axioms StrictEUnit.integer_mul_of_reduced_den_dvd
#print axioms StrictEUnit.integer_of_primitive_integer_products
#print axioms StrictEUnit.invertible_integral_ideal_eq_gcd
#print axioms StrictEUnit.invertible_integral_ideal_isPrincipal
#print axioms StrictEUnit.invertible_fractional_ideal_isPrincipal
