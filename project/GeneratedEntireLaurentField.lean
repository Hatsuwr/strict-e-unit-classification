import Stage14ActualAnalyticODETransfer
import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs

/-! New reconstruction, not recovered historical source.
The field definition required by the retained absolute-primality proof, and
its embedding in the field of genuine entire-function fractions. The analytic
relative-closure theorem is deliberately not asserted in this module. -/
noncomputable section
set_option maxHeartbeats 200000
set_option synthInstance.maxHeartbeats 20000
namespace StrictEUnit

/-- The field over k(t) generated by specified genuine entire Taylor images. -/
def generatedEntireLaurentField (k : Subfield ℂ)
    (s : Set (subfieldEntireFunctionAlgebra k)) :
    IntermediateField (RatFunc k) (LaurentSeries k) :=
  IntermediateField.adjoin (RatFunc k)
    (stage14_subfieldEntireLaurentAlgHom k '' s)

/-- Every polynomial Laurent image is the Taylor image of an actual entire
polynomial, so it belongs to the fraction field of genuine entire images. -/
theorem polynomial_mem_entireLaurentFractionSubfield (k : Subfield ℂ)
    (p : Polynomial k) :
    algebraMap (Polynomial k) (LaurentSeries k) p ∈
      Subfield.closure (Set.range (stage14_subfieldEntireLaurentAlgHom k)) := by
  rw [← stage14_subfieldEntireLaurentAlgHom_polynomial]
  exact Subfield.subset_closure ⟨_, rfl⟩

/-- Every rational Laurent image belongs to the same genuine fraction field. -/
theorem rational_mem_entireLaurentFractionSubfield (k : Subfield ℂ)
    (r : RatFunc k) :
    algebraMap (RatFunc k) (LaurentSeries k) r ∈
      Subfield.closure (Set.range (stage14_subfieldEntireLaurentAlgHom k)) := by
  induction r using RatFunc.induction_on
  rename_i p q hq
  rw [map_div₀,
      ← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) (LaurentSeries k),
      ← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) (LaurentSeries k)]
  exact Subfield.div_mem _ (polynomial_mem_entireLaurentFractionSubfield k p)
    (polynomial_mem_entireLaurentFractionSubfield k q)

/-- The entire-image fraction field viewed as an extension of the actual k(t). -/
def entireLaurentFractionField (k : Subfield ℂ) :
    IntermediateField (RatFunc k) (LaurentSeries k) :=
  (Subfield.closure (Set.range (stage14_subfieldEntireLaurentAlgHom k))).toIntermediateField
    (rational_mem_entireLaurentFractionSubfield k)

/-- The generated field contains only fractions of genuine entire images. -/
theorem generatedEntireLaurentField_le_entireLaurentFractionField
    (k : Subfield ℂ) (s : Set (subfieldEntireFunctionAlgebra k)) :
    generatedEntireLaurentField k s ≤ entireLaurentFractionField k := by
  apply IntermediateField.adjoin_le_iff.mpr
  rintro x ⟨f, _, rfl⟩
  exact Subfield.subset_closure ⟨f, rfl⟩

/-- Membership in the entire-image fraction field has a concrete numerator
and denominator among the actual entire functions. -/
theorem entireLaurentFractionField_exists_fraction
    (k : Subfield ℂ) {x : LaurentSeries k} (hx : x ∈ entireLaurentFractionField k) :
    ∃ f g : subfieldEntireFunctionAlgebra k,
      x = stage14_subfieldEntireLaurentAlgHom k f /
        stage14_subfieldEntireLaurentAlgHom k g := by
  letI : CommRing entireFunctionAlgebra := Subalgebra.toCommRing entireFunctionAlgebra
  letI : CommRing (subfieldEntireFunctionAlgebra k) :=
    Subalgebra.toCommRing (subfieldEntireFunctionAlgebra k)
  have hsub : Subring.closure (Set.range (stage14_subfieldEntireLaurentAlgHom k)) ≤
      (stage14_subfieldEntireLaurentAlgHom k).toRingHom.range := by
    exact Subring.closure_le.mpr (fun _ h => h)
  obtain ⟨a, ha, b, hb, hab⟩ := Subfield.mem_closure_iff.mp hx
  obtain ⟨f, hf⟩ := hsub ha
  obtain ⟨g, hg⟩ := hsub hb
  refine ⟨f, g, ?_⟩
  change x = (stage14_subfieldEntireLaurentAlgHom k).toRingHom f /
    (stage14_subfieldEntireLaurentAlgHom k).toRingHom g
  rw [hf, hg]
  exact hab.symm

/-- The denominator can be chosen nonzero; this is the form needed for
analytic meromorphic realization. -/
theorem entireLaurentFractionField_exists_fraction_nonzero
    (k : Subfield ℂ) {x : LaurentSeries k} (hx : x ∈ entireLaurentFractionField k) :
    ∃ f g : subfieldEntireFunctionAlgebra k, g ≠ 0 ∧
      x = stage14_subfieldEntireLaurentAlgHom k f /
        stage14_subfieldEntireLaurentAlgHom k g := by
  letI : CommRing entireFunctionAlgebra := Subalgebra.toCommRing entireFunctionAlgebra
  letI : CommRing (subfieldEntireFunctionAlgebra k) :=
    Subalgebra.toCommRing (subfieldEntireFunctionAlgebra k)
  obtain ⟨f, g, hfg⟩ := entireLaurentFractionField_exists_fraction k hx
  by_cases hg : g = 0
  · have hone : (1 : subfieldEntireFunctionAlgebra k) ≠ 0 := by
      intro h
      have he := congrArg (fun a : subfieldEntireFunctionAlgebra k => a.val.val 0) h
      change (1 : ℂ) = 0 at he
      exact (one_ne_zero : (1 : ℂ) ≠ 0) he
    refine ⟨0, 1, hone, ?_⟩
    simpa only [hg, map_zero, map_one, div_zero, zero_div] using hfg
  · exact ⟨f, g, hg, hfg⟩

end StrictEUnit
