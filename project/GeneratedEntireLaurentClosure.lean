import GeneratedEntireLaurentField
import LaurentIntegralScaling
import LaurentRationalDescent
import LaurentCoefficientExtension
import EntireFractionIntegralPolynomial
import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed

/-! New reconstruction, not recovered historical source.
Relative closure follows from genuine entire-fraction representations,
polynomial integral scaling, analytic monic rigidity over ℂ, and coefficient
rationality descent. No desired closure or geometric-domain assertion is an
input to this proof. -/
noncomputable section
set_option maxHeartbeats 200000
set_option synthInstance.maxHeartbeats 20000
namespace StrictEUnit

/-- Coefficient extension recovers the actual complex entire Taylor image. -/
@[simp] theorem relativeClosureLaurentMap_entire (k : Subfield ℂ)
    (f : subfieldEntireFunctionAlgebra k) :
    relativeClosureLaurentMap k.subtype (stage14_subfieldEntireLaurentAlgHom k f) =
      entireLaurentRingHom f.val := by
  rw [stage14_subfieldEntireLaurentAlgHom_apply,
    relativeClosureLaurentMap_ofPowerSeries, subfieldEntireTaylorAlgHom_compatibility]
  rfl

/-- An algebraic element of the genuine entire-image fraction field belongs
to the original rational-function field. -/
theorem entireLaurentFractionField_algebraMap_eq_of_integral
    (k : Subfield ℂ) {x : LaurentSeries k}
    (hx : x ∈ entireLaurentFractionField k) (hint : IsIntegral (RatFunc k) x) :
    ∃ r : RatFunc k, algebraMap (RatFunc k) (LaurentSeries k) r = x := by
  obtain ⟨f, g, hg, hfg⟩ := entireLaurentFractionField_exists_fraction_nonzero k hx
  obtain ⟨q, hq, hqx⟩ := integral_laurent_exists_polynomial_multiple hint
  let F : entireFunctionAlgebra := polynomialEntireAlgHom (q.map k.subtype) * f.val
  let G : entireFunctionAlgebra := g.val
  have hG : G ≠ 0 := by
    intro h
    exact hg (Subtype.ext h)
  have hreal : relativeClosureLaurentMap k.subtype
      (algebraMap (Polynomial k) (LaurentSeries k) q * x) =
      entireLaurentRingHom F / entireLaurentRingHom G := by
    rw [map_mul, relativeClosureLaurentMap_polynomial, hfg, map_div₀,
      relativeClosureLaurentMap_entire, relativeClosureLaurentMap_entire]
    simp only [F, G, map_mul, entireLaurentRingHom_polynomial, mul_div_assoc]
  have hcomplex : IsIntegral (Polynomial ℂ)
      (entireLaurentRingHom F / entireLaurentRingHom G) := by
    rw [← hreal]
    exact relativeClosureLaurentMap_isIntegral k.subtype hqx
  obtain ⟨P, hP⟩ := entire_fraction_eq_polynomial_of_integral F G hG hcomplex
  have hQ : q.map k.subtype ≠ 0 := by
    intro h
    apply hq
    apply Polynomial.map_injective k.subtype Subtype.val_injective
    simpa only [Polynomial.map_zero] using h
  have hidentity : algebraMap (Polynomial ℂ) (LaurentSeries ℂ) P =
      algebraMap (Polynomial ℂ) (LaurentSeries ℂ) (q.map k.subtype) *
        x.map (algebraMap k ℂ) := by
    rw [← hP, ← hreal, map_mul, relativeClosureLaurentMap_polynomial]
    rfl
  exact laurent_rational_descends_of_polynomial_identity
    x P (q.map k.subtype) hQ hidentity

/-- The rational-function field is relatively algebraically closed in the
field generated by any specified genuine entire Taylor images. -/
theorem generatedEntireLaurentField_integrallyClosedIn
    (k : Subfield ℂ) (s : Set (subfieldEntireFunctionAlgebra k)) :
    @IsIntegrallyClosedIn (RatFunc k) (generatedEntireLaurentField k s) _ _
      (generatedEntireLaurentField k s).toSubalgebra.algebra := by
  letI : Algebra (RatFunc k) (generatedEntireLaurentField k s) :=
    (generatedEntireLaurentField k s).toSubalgebra.algebra
  apply isIntegrallyClosedIn_iff.mpr
  refine ⟨(algebraMap (RatFunc k) (generatedEntireLaurentField k s)).injective, ?_⟩
  intro x hx
  have hxin : (x : LaurentSeries k) ∈ entireLaurentFractionField k :=
    generatedEntireLaurentField_le_entireLaurentFractionField k s x.property
  have hxint : IsIntegral (RatFunc k) (x : LaurentSeries k) :=
    (isIntegral_algHom_iff (generatedEntireLaurentField k s).val
      Subtype.val_injective).mpr hx
  obtain ⟨r, hr⟩ := entireLaurentFractionField_algebraMap_eq_of_integral k hxin hxint
  refine ⟨r, ?_⟩
  apply Subtype.ext
  exact hr

end StrictEUnit
