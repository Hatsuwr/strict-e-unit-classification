import FiniteBasisConductor
import Mathlib.RingTheory.Discriminant

noncomputable section
open scoped NumberField
namespace StrictEUnit

/-- A rational power basis generated by an integral element yields one
nonzero integer clearing every integral element into its power order. -/
theorem powerBasis_exists_integer_clearing
    {K : Type*} [Field K] [NumberField K]
    (B : PowerBasis ℚ K) (hint : IsIntegral ℤ B.gen) :
    ∃ d : ℤ, d ≠ 0 ∧ ∀ z : K, IsIntegral ℤ z →
      (d : K) * z ∈ Algebra.adjoin ℤ {B.gen} := by
  have hi : IsIntegral ℤ (Algebra.discr ℚ B.basis) :=
    Algebra.discr_isIntegral ℚ (fun i => by rw [B.basis_eq_pow]; exact hint.pow _)
  obtain ⟨d, hd⟩ := (IsIntegrallyClosed.isIntegral_iff).mp hi
  have hn := Algebra.discr_not_zero_of_basis ℚ B.basis
  have hd0 : d ≠ 0 := by
    intro hz
    subst d
    exact hn (hd.symm.trans (map_zero _))
  refine ⟨d, hd0, ?_⟩
  intro z hz
  have h := Algebra.discr_mul_isIntegral_mem_adjoin ℚ hint hz
  rw [← hd, algebraMap_smul, Algebra.smul_def] at h
  exact h

/-- The clearing integer belongs to the actual conductor in the ring of
integers, without assuming that this ring is monogenic. -/
theorem numberField_powerBasis_integer_conductor
    {K : Type*} [Field K] [NumberField K]
    (a : 𝓞 K) (B : PowerBasis ℚ K) (hgen : B.gen = (a : K)) :
    ∃ d : ℤ, d ≠ 0 ∧ algebraMap ℤ (𝓞 K) d ∈ conductor ℤ a := by
  obtain ⟨d, hd, hclear⟩ := powerBasis_exists_integer_clearing B
    (by rw [hgen]; exact (NumberField.RingOfIntegers.isIntegral a).algebraMap)
  refine ⟨d, hd, mem_conductor_iff.mpr ?_⟩
  intro z
  have hz := hclear (z : K) ((NumberField.RingOfIntegers.isIntegral z).algebraMap)
  rw [hgen] at hz
  let f : (𝓞 K) →ₐ[ℤ] K := IsScalarTower.toAlgHom ℤ (𝓞 K) K
  have hm : (d : K) * (z : K) ∈ (Algebra.adjoin ℤ {a}).map f := by
    simpa only [AlgHom.map_adjoin, Set.image_singleton] using hz
  obtain ⟨y, hy, he⟩ := hm
  have heq : y = algebraMap ℤ (𝓞 K) d * z := by
    apply (FaithfulSMul.algebraMap_injective (𝓞 K) K)
    simpa [f] using he
  exact heq ▸ hy

/-- Only finitely many rational primes can violate conductor coprimality
for an integral rational power-basis generator. -/
theorem numberField_powerBasis_conductor_finite_exceptions
    {K : Type*} [Field K] [NumberField K]
    (a : 𝓞 K) (B : PowerBasis ℚ K) (hgen : B.gen = (a : K)) :
    ∃ T : Finset ℕ, ∀ p : ℕ, p.Prime → p ∉ T →
      (conductor ℤ a).comap (algebraMap ℤ (𝓞 K)) ⊔
        Ideal.span {(p : ℤ)} = ⊤ := by
  obtain ⟨d, hd, hdc⟩ := numberField_powerBasis_integer_conductor a B hgen
  refine ⟨d.natAbs.divisors, ?_⟩
  intro p hp hnot
  have hpn : (p : ℤ) ≠ 0 := by exact_mod_cast hp.ne_zero
  have hP : (Ideal.span {(p : ℤ)}).IsPrime :=
    (Ideal.span_singleton_prime hpn).mpr (Nat.prime_iff_prime_int.mp hp)
  have hP0 : (Ideal.span {(p : ℤ)} : Ideal ℤ) ≠ ⊥ := by
    intro he
    have hm : (p : ℤ) ∈ Ideal.span {(p : ℤ)} := Ideal.subset_span (by simp)
    rw [he, Ideal.mem_bot] at hm
    exact hpn hm
  letI : (Ideal.span {(p : ℤ)}).IsMaximal := hP.isMaximal hP0
  apply conductor_coprime_of_integer_not_mem a d hdc
  intro hm
  apply hnot
  exact Nat.mem_divisors.mpr
    ⟨Int.natCast_dvd.mp (Ideal.mem_span_singleton.mp hm), Int.natAbs_ne_zero.mpr hd⟩

/-- Applied in the actual simple field Q(alpha), the conductor has only
finitely many exceptional rational primes. No larger-field generation is assumed. -/
theorem simpleField_conductor_finite_exceptions
    {K : Type*} [Field K] [NumberField K] (a : K) (ha : IsIntegral ℤ a) :
    ∃ a' : 𝓞 (IntermediateField.adjoin ℚ {a}),
      algebraMap (IntermediateField.adjoin ℚ {a}) K (a' : IntermediateField.adjoin ℚ {a}) = a ∧
      ∃ T : Finset ℕ, ∀ p : ℕ, p.Prime → p ∉ T →
        (conductor ℤ a').comap (algebraMap ℤ (𝓞 (IntermediateField.adjoin ℚ {a}))) ⊔
          Ideal.span {(p : ℤ)} = ⊤ := by
  let B := IntermediateField.adjoin.powerBasis (IsIntegral.of_finite ℚ a)
  have hg : IsIntegral ℤ B.gen := by
    apply (isIntegral_algebraMap_iff
      (FaithfulSMul.algebraMap_injective (IntermediateField.adjoin ℚ {a}) K)).mp
    exact ha
  let a' : 𝓞 (IntermediateField.adjoin ℚ {a}) := ⟨B.gen, hg⟩
  refine ⟨a', rfl, ?_⟩
  exact numberField_powerBasis_conductor_finite_exceptions a' B rfl

end StrictEUnit
end
