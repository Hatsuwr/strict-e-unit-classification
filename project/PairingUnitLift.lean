import Mathlib.RingTheory.Flat.FaithfullyFlat.Basic

/-!
# From a cyclic weight module and a locally surjective pairing to a regular unit

This file proves the final module-theoretic implication used in Section 10 of
the proposed strict E-value unit argument. Faithful flatness, a generator, a
pairing, and its compatibility with multiplication are explicit hypotheses.

It does NOT construct the torsor, identify its weight modules, establish
Picard triviality, or prove that the actual character pairing becomes an
isomorphism on a trivializing cover. In particular, no generator or local
surjectivity is silently asserted for the manuscript's concrete rings.

The result needs only a cyclic generator, not a free rank-one basis, and
only local surjectivity of the pairing, not a local isomorphism.
-/

namespace StrictEUnit

open TensorProduct

section TensorGenerator

variable {B M N : Type*} [CommRing B]
  [AddCommGroup M] [Module B M] [AddCommGroup N] [Module B N]

/-- If the left module is generated by `v`, every tensor is a single pure
tensor with that fixed left factor. This includes arbitrary sums of tensors. -/
theorem tensor_eq_generator_tmul
    (v : M) (hv : ∀ m : M, ∃ b : B, m = b • v)
    (t : M ⊗[B] N) : ∃ n : N, t = v ⊗ₜ[B] n := by
  induction t using TensorProduct.induction_on with
  | zero => exact ⟨0, by simp⟩
  | tmul m n =>
      obtain ⟨b, rfl⟩ := hv m
      exact ⟨b • n, TensorProduct.smul_tmul b v n⟩
  | add t₁ t₂ h₁ h₂ =>
      obtain ⟨n₁, rfl⟩ := h₁
      obtain ⟨n₂, rfl⟩ := h₂
      exact ⟨n₁ + n₂, (TensorProduct.tmul_add v n₁ n₂).symm⟩

/-- A surjective pairing with a cyclic left factor can attain every scalar
while keeping the left factor fixed at the chosen generator. -/
theorem pairing_attains_at_generator
    (μ : M ⊗[B] N →ₗ[B] B)
    (v : M) (hv : ∀ m : M, ∃ b : B, m = b • v)
    (hμ : Function.Surjective μ) (b : B) :
    ∃ n : N, μ (v ⊗ₜ[B] n) = b := by
  obtain ⟨t, ht⟩ := hμ b
  obtain ⟨n, hn⟩ := tensor_eq_generator_tmul v hv t
  exact ⟨n, by simpa only [hn] using ht⟩

/-- Faithfully flat base change reflects surjectivity of the pairing.
The local surjectivity premise must still be established in an application. -/
theorem pairing_surjective_of_faithfully_flat
    (A : Type*) [AddCommGroup A] [Module B A] [Module.FaithfullyFlat B A]
    (μ : M ⊗[B] N →ₗ[B] B)
    (hlocal : Function.Surjective (μ.lTensor A)) : Function.Surjective μ :=
  (Module.FaithfullyFlat.lTensor_surjective_iff_surjective B A μ).mp hlocal

/-- Combining actual descent of surjectivity with the fixed-generator tensor
calculation gives a right factor paired to the scalar `1`. -/
theorem pairing_one_at_generator_of_faithfully_flat
    (A : Type*) [AddCommGroup A] [Module B A] [Module.FaithfullyFlat B A]
    (μ : M ⊗[B] N →ₗ[B] B)
    (v : M) (hv : ∀ m : M, ∃ b : B, m = b • v)
    (hlocal : Function.Surjective (μ.lTensor A)) :
    ∃ n : N, μ (v ⊗ₜ[B] n) = 1 :=
  pairing_attains_at_generator μ v hv
    (pairing_surjective_of_faithfully_flat A μ hlocal) 1

/-- A genuine free rank-one trivialization supplies the cyclic generator
required above. Obtaining this equivalence from Picard triviality is separate. -/
theorem generator_of_rank_one_equiv (e : B ≃ₗ[B] M) :
    ∀ m : M, ∃ b : B, m = b • e 1 := by
  intro m
  refine ⟨e.symm m, ?_⟩
  rw [← e.map_smul]
  simp

/-- Regression check: tensoring with the zero module makes even the zero
pairing surjective. Local surjectivity does not descend if faithfulness is
omitted. This is a counterexample about descent, not about the E-value rings. -/
theorem faithfulness_cannot_be_omitted {B : Type*} [CommRing B] [Nontrivial B] :
    Function.Surjective ((0 : B ⊗[B] B →ₗ[B] B).lTensor PUnit) ∧
      ¬ Function.Surjective (0 : B ⊗[B] B →ₗ[B] B) := by
  constructor
  · exact Function.surjective_to_subsingleton _
  · intro h
    obtain ⟨t, ht⟩ := h 1
    simp at ht

end TensorGenerator

section RegularUnit

variable {B R : Type*} [CommRing B] [CommRing R] [Algebra B R]

/-- The inverse supplied by the descended pairing lies in the prescribed
right submodule of the original algebra, not merely in a fraction field. -/
theorem regular_inverse_of_faithfully_flat_pairing
    (A : Type*) [AddCommGroup A] [Module B A] [Module.FaithfullyFlat B A]
    (M N : Submodule B R)
    (μ : M ⊗[B] N →ₗ[B] B)
    (hproduct : ∀ m : M, ∀ n : N,
      algebraMap B R (μ (m ⊗ₜ[B] n)) = (m : R) * (n : R))
    (v : M) (hv : ∀ m : M, ∃ b : B, m = b • v)
    (hlocal : Function.Surjective (μ.lTensor A)) :
    ∃ w : N, (v : R) * (w : R) = 1 := by
  obtain ⟨w, hw⟩ := pairing_one_at_generator_of_faithfully_flat A μ v hv hlocal
  refine ⟨w, ?_⟩
  rw [← hproduct v w, hw, map_one]

/-- The generator is therefore a unit of the actual algebra. -/
theorem isUnit_of_faithfully_flat_pairing
    (A : Type*) [AddCommGroup A] [Module B A] [Module.FaithfullyFlat B A]
    (M N : Submodule B R)
    (μ : M ⊗[B] N →ₗ[B] B)
    (hproduct : ∀ m : M, ∀ n : N,
      algebraMap B R (μ (m ⊗ₜ[B] n)) = (m : R) * (n : R))
    (v : M) (hv : ∀ m : M, ∃ b : B, m = b • v)
    (hlocal : Function.Surjective (μ.lTensor A)) : IsUnit (v : R) := by
  obtain ⟨w, hw⟩ := regular_inverse_of_faithfully_flat_pairing A M N μ hproduct v hv hlocal
  exact isUnit_of_mul_eq_one (v : R) (w : R) hw

/-- Rank-one trivialization version: a generator from a supplied module
equivalence is a regular unit once the multiplication pairing is locally
surjective on a faithfully flat cover. -/
theorem rank_one_generator_isUnit_of_faithfully_flat_pairing
    (A : Type*) [AddCommGroup A] [Module B A] [Module.FaithfullyFlat B A]
    (M N : Submodule B R)
    (μ : M ⊗[B] N →ₗ[B] B)
    (hproduct : ∀ m : M, ∀ n : N,
      algebraMap B R (μ (m ⊗ₜ[B] n)) = (m : R) * (n : R))
    (e : B ≃ₗ[B] M)
    (hlocal : Function.Surjective (μ.lTensor A)) : IsUnit (e 1 : R) :=
  isUnit_of_faithfully_flat_pairing A M N μ hproduct (e 1)
    (generator_of_rank_one_equiv e) hlocal

end RegularUnit

#print axioms tensor_eq_generator_tmul
#print axioms pairing_attains_at_generator
#print axioms pairing_surjective_of_faithfully_flat
#print axioms pairing_one_at_generator_of_faithfully_flat
#print axioms generator_of_rank_one_equiv
#print axioms faithfulness_cannot_be_omitted
#print axioms regular_inverse_of_faithfully_flat_pairing
#print axioms isUnit_of_faithfully_flat_pairing
#print axioms rank_one_generator_isUnit_of_faithfully_flat_pairing

end StrictEUnit
