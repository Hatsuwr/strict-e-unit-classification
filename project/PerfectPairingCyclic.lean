import PicardIngredient
import Mathlib.LinearAlgebra.TensorProduct.Basic

/-!
The global generator is derived rather than assumed: multiplication-compatible
submodules in a domain, with a surjective base-valued tensor pairing over a UFD,
give an invertible integral ideal. Principality then gives a cyclic generator.
No torsor construction, flat descent, or strict E-function facts are assumed to
have been instantiated by this general algebra theorem.
-/

noncomputable section

open scoped nonZeroDivisors
open TensorProduct

namespace StrictEUnit

variable {B R : Type*} [CommRing B] [IsDomain B] [UniqueFactorizationMonoid B]
  [CommRing R] [IsDomain R] [Algebra B R]

omit [UniqueFactorizationMonoid B] [IsDomain R] in
/-- A surjective multiplication-compatible pairing has a nonzero pure value. -/
theorem exists_nonzero_pure_pairing
    (M N : Submodule B R) (μ : M ⊗[B] N →ₗ[B] B)
    (hμ : Function.Surjective μ) :
    ∃ m : M, ∃ n : N, μ (m ⊗ₜ[B] n) ≠ 0 := by
  classical
  by_contra h
  have hpure (m : M) (n : N) : μ (m ⊗ₜ[B] n) = 0 := by
    by_contra hn
    exact h ⟨m, n, hn⟩
  have hzero : μ = 0 := by
    apply TensorProduct.ext'
    intro m n
    exact hpure m n
  obtain ⟨t, ht⟩ := hμ 1
  simp [hzero] at ht

omit [IsDomain B] [UniqueFactorizationMonoid B] [IsDomain R] in
/-- The two integral ideals obtained by fixing opposite factors multiply to
the principal ideal generated by the fixed pairing value. -/
theorem pairing_range_ideals_mul
    (hinj : Function.Injective (algebraMap B R))
    (M N : Submodule B R) (μ : M ⊗[B] N →ₗ[B] B)
    (hμ : Function.Surjective μ)
    (hcompat : ∀ (m : M) (n : N),
      algebraMap B R (μ (m ⊗ₜ[B] n)) = (m : R) * (n : R))
    (m₀ : M) (n₀ : N) :
    LinearMap.range (μ.comp ((TensorProduct.mk B M N).flip n₀)) *
      LinearMap.range (μ.comp (TensorProduct.mk B M N m₀)) =
        Ideal.span {μ (m₀ ⊗ₜ[B] n₀)} := by
  let f : M →ₗ[B] B := μ.comp ((TensorProduct.mk B M N).flip n₀)
  let g : N →ₗ[B] B := μ.comp (TensorProduct.mk B M N m₀)
  let c := μ (m₀ ⊗ₜ[B] n₀)
  let I : Ideal B := LinearMap.range f
  let J : Ideal B := LinearMap.range g
  have hprod (m : M) (n : N) : f m * g n = c * μ (m ⊗ₜ[B] n) := by
    apply hinj
    simp only [map_mul]
    change algebraMap B R (μ (m ⊗ₜ[B] n₀)) *
        algebraMap B R (μ (m₀ ⊗ₜ[B] n)) =
      algebraMap B R (μ (m₀ ⊗ₜ[B] n₀)) * algebraMap B R (μ (m ⊗ₜ[B] n))
    rw [hcompat, hcompat, hcompat, hcompat]
    ring
  change I * J = Ideal.span {c}
  apply le_antisymm
  · apply Ideal.mul_le.mpr
    rintro a ⟨m, rfl⟩ b ⟨n, rfl⟩
    exact Ideal.mem_span_singleton.mpr ⟨μ (m ⊗ₜ[B] n), hprod m n⟩
  · apply Ideal.span_le.mpr
    intro a ha
    have hac : a = c := Set.mem_singleton_iff.mp ha
    subst a
    obtain ⟨t, ht⟩ := hμ 1
    have hall : ∀ t : M ⊗[B] N, c * μ t ∈ I * J := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul m n =>
          rw [← hprod]
          exact Ideal.mul_mem_mul (LinearMap.mem_range_self f m)
            (LinearMap.mem_range_self g n)
      | add x y hx hy =>
          simpa only [map_add, mul_add] using (I * J).add_mem hx hy
    simpa only [ht, mul_one] using hall t

omit [UniqueFactorizationMonoid B] in
/-- If two integral ideals multiply to a nonzero principal ideal, either is
invertible as a fractional ideal. The inverse is constructed explicitly. -/
theorem integral_ideal_isUnit_of_product_principal
    (I J : Ideal B) (c : B) (hc : c ≠ 0) (hIJ : I * J = Ideal.span {c}) :
    IsUnit (I : FractionalIdeal B⁰ (FractionRing B)) := by
  let K := FractionRing B
  let cK := algebraMap B K c
  have hcK : cK ≠ 0 := by
    intro h
    apply hc
    apply FaithfulSMul.algebraMap_injective B K
    simpa only [map_zero] using h
  have hIJ' : (I : FractionalIdeal B⁰ K) * (J : FractionalIdeal B⁰ K) =
      FractionalIdeal.spanSingleton B⁰ cK := by
    rw [← FractionalIdeal.coeIdeal_mul, hIJ, FractionalIdeal.coeIdeal_span_singleton]
  apply isUnit_of_mul_eq_one (I : FractionalIdeal B⁰ K)
    ((J : FractionalIdeal B⁰ K) * FractionalIdeal.spanSingleton B⁰ cK⁻¹)
  rw [← mul_assoc, hIJ', FractionalIdeal.spanSingleton_mul_spanSingleton,
    mul_inv_cancel₀ hcK, FractionalIdeal.spanSingleton_one]

/-- A cyclic generator follows from the UFD property and a surjective
multiplication-compatible pairing. No generator, freeness, Picard-triviality,
or fractional-ideal realization is an additional hypothesis. -/
theorem cyclic_of_surjective_multiplication_pairing
    (hinj : Function.Injective (algebraMap B R))
    (M N : Submodule B R) (μ : M ⊗[B] N →ₗ[B] B)
    (hμ : Function.Surjective μ)
    (hcompat : ∀ (m : M) (n : N),
      algebraMap B R (μ (m ⊗ₜ[B] n)) = (m : R) * (n : R)) :
    ∃ v : M, ∀ m : M, ∃ b : B, m = b • v := by
  obtain ⟨m₀, n₀, hc⟩ := exists_nonzero_pure_pairing M N μ hμ
  let f : M →ₗ[B] B := μ.comp ((TensorProduct.mk B M N).flip n₀)
  let g : N →ₗ[B] B := μ.comp (TensorProduct.mk B M N m₀)
  let c := μ (m₀ ⊗ₜ[B] n₀)
  let I : Ideal B := LinearMap.range f
  let J : Ideal B := LinearMap.range g
  have hIJ : I * J = Ideal.span {c} :=
    pairing_range_ideals_mul hinj M N μ hμ hcompat m₀ n₀
  have hn₀ : (n₀ : R) ≠ 0 := by
    intro hn
    apply hc
    apply hinj
    rw [hcompat, hn, mul_zero, map_zero]
  have hf : Function.Injective f := by
    intro m₁ m₂ heq
    apply Subtype.ext
    apply mul_right_cancel₀ hn₀
    have hm := congrArg (algebraMap B R) heq
    change algebraMap B R (μ (m₁ ⊗ₜ[B] n₀)) =
      algebraMap B R (μ (m₂ ⊗ₜ[B] n₀)) at hm
    simpa only [hcompat] using hm
  have hIunit : IsUnit (I : FractionalIdeal B⁰ (FractionRing B)) :=
    integral_ideal_isUnit_of_product_principal I J c hc hIJ
  have hprincipal : I.IsPrincipal := invertible_integral_ideal_isPrincipal I hIunit
  obtain ⟨a, ha⟩ := (Submodule.isPrincipal_iff I).mp hprincipal
  have hamem : a ∈ I := by
    rw [ha]
    exact Submodule.mem_span_singleton_self a
  obtain ⟨v, hv⟩ := hamem
  refine ⟨v, ?_⟩
  intro m
  have hm : f m ∈ I := LinearMap.mem_range_self f m
  rw [ha] at hm
  obtain ⟨b, hb⟩ := Submodule.mem_span_singleton.mp hm
  refine ⟨b, ?_⟩
  apply hf
  rw [map_smul, hv]
  exact hb.symm

end StrictEUnit

#print axioms StrictEUnit.exists_nonzero_pure_pairing
#print axioms StrictEUnit.pairing_range_ideals_mul
#print axioms StrictEUnit.integral_ideal_isUnit_of_product_principal
#print axioms StrictEUnit.cyclic_of_surjective_multiplication_pairing
