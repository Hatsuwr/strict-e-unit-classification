import MatrixGeneratedDifferentialAlgebra
import Mathlib.RingTheory.Localization.Away.Basic

/-! Localization of an actual subalgebra obtained by adjoining an inverse. -/
noncomputable section
namespace StrictEUnit
variable {B L : Type*} [CommRing B] [Field L] [Algebra B L]

/-- Every element of the actual inverse-adjoined subalgebra has a denominator
which is a power of the inverted element. -/
theorem adjoinInverse_exists_denominator (R : Subalgebra B L) (d : R)
    (hd : d ≠ 0) (x : L)
    (hx : x ∈ Algebra.adjoin B (insert (d : L)⁻¹ (R : Set L))) :
    ∃ n : ℕ, x * (d : L) ^ n ∈ R := by
  have hdL : (d : L) ≠ 0 := fun h => hd (Subtype.ext h)
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    rcases hx with rfl | hx
    · exact ⟨1, by simpa [hdL] using R.one_mem⟩
    · exact ⟨0, by simpa using hx⟩
  | algebraMap b => exact ⟨0, by simpa using R.algebraMap_mem b⟩
  | add x y hx hy ihx ihy =>
    obtain ⟨m, hm⟩ := ihx
    obtain ⟨n, hn⟩ := ihy
    refine ⟨m + n, ?_⟩
    have heq : (x + y) * (d : L) ^ (m + n) =
        (x * (d : L) ^ m) * (d : L) ^ n +
          (y * (d : L) ^ n) * (d : L) ^ m := by rw [pow_add]; ring
    rw [heq]
    exact R.add_mem (R.mul_mem hm (R.pow_mem d.property n))
      (R.mul_mem hn (R.pow_mem d.property m))
  | mul x y hx hy ihx ihy =>
    obtain ⟨m, hm⟩ := ihx
    obtain ⟨n, hn⟩ := ihy
    refine ⟨m + n, ?_⟩
    have heq : (x * y) * (d : L) ^ (m + n) =
        (x * (d : L) ^ m) * (y * (d : L) ^ n) := by rw [pow_add]; ring
    rw [heq]
    exact R.mul_mem hm hn

/-- An actual subalgebra generated by a smaller subalgebra and one inverse is
its localization away from the inverted element, for the inclusion algebra. -/
theorem subalgebra_isLocalization_away (R S : Subalgebra B L) (d : R)
    [Algebra R S]
    (hmap : ∀ r : R, ((algebraMap R S r : S) : L) = (r : L))
    (hd : d ≠ 0)
    (hS : S = Algebra.adjoin B (insert (d : L)⁻¹ (R : Set L))) :
    IsLocalization.Away d S := by
  have hdL : (d : L) ≠ 0 := fun h => hd (Subtype.ext h)
  have hinv : (d : L)⁻¹ ∈ S := by rw [hS]; exact Algebra.subset_adjoin (Set.mem_insert _ _)
  apply IsLocalization.Away.mk d
  · refine ⟨⟨algebraMap R S d, ⟨(d : L)⁻¹, hinv⟩, ?_, ?_⟩, rfl⟩
    · apply Subtype.ext
      change ((algebraMap R S d : S) : L) * (d : L)⁻¹ = 1
      rw [hmap, mul_inv_cancel₀ hdL]
    · apply Subtype.ext
      change (d : L)⁻¹ * ((algebraMap R S d : S) : L) = 1
      rw [hmap, inv_mul_cancel₀ hdL]
  · intro s
    obtain ⟨n, hn⟩ := adjoinInverse_exists_denominator R d hd (s : L) (hS ▸ s.property)
    refine ⟨n, ⟨(s : L) * (d : L) ^ n, hn⟩, ?_⟩
    apply Subtype.ext
    change (s : L) * (((algebraMap R S d : S) : L) ^ n) =
      ((algebraMap R S ⟨(s : L) * (d : L) ^ n, hn⟩ : S) : L)
    simp only [hmap]
  · intro a b hab
    have hab' : a = b := Subtype.ext (by simpa only [hmap] using congrArg Subtype.val hab)
    exact ⟨0, by simp [hab']⟩

/-- A version that supplies the natural inclusion algebra explicitly. -/
theorem subalgebra_inclusion_isLocalization_away (R S : Subalgebra B L)
    (hRS : R ≤ S) (d : R) (hd : d ≠ 0)
    (hS : S = Algebra.adjoin B (insert (d : L)⁻¹ (R : Set L))) :
    letI : Algebra R S := (Subalgebra.inclusion hRS).toRingHom.toAlgebra
    IsLocalization.Away d S := by
  letI : Algebra R S := (Subalgebra.inclusion hRS).toRingHom.toAlgebra
  exact subalgebra_isLocalization_away R S d (fun _ => rfl) hd hS

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The determinant as an element of the actual entry algebra. -/
def matrixEntryDet (Y : Matrix n n L) : matrixEntryAlgebra (B := B) Y :=
  ⟨Y.det, matrixDet_mem Y⟩

/-- The original matrix-generated algebra is precisely the entry algebra with
its determinant inverse adjoined. -/
theorem matrixGeneratedAlgebra_eq_adjoin_inverse (Y : Matrix n n L) :
    matrixGeneratedAlgebra (B := B) Y = Algebra.adjoin B
      (insert Y.det⁻¹ (matrixEntryAlgebra (B := B) Y : Set L)) := by
  apply le_antisymm
  · apply Algebra.adjoin_le
    intro x hx
    rcases hx with rfl | hx
    · exact Algebra.subset_adjoin (Set.mem_insert _ _)
    · exact Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Algebra.subset_adjoin hx))
  · apply Algebra.adjoin_le
    intro x hx
    rcases hx with rfl | hx
    · exact Algebra.subset_adjoin (Set.mem_insert _ _)
    · exact matrixEntryAlgebra_le Y hx

/-- The actual matrix-generated algebra, with any inclusion-compatible algebra
structure, is the determinant localization of its entry algebra. -/
theorem matrixGenerated_isLocalization_away (Y : Matrix n n L) (hdet : Y.det ≠ 0)
    [Algebra (matrixEntryAlgebra (B := B) Y) (matrixGeneratedAlgebra (B := B) Y)]
    (hmap : ∀ r : matrixEntryAlgebra (B := B) Y,
      ((algebraMap (matrixEntryAlgebra (B := B) Y)
        (matrixGeneratedAlgebra (B := B) Y) r : matrixGeneratedAlgebra (B := B) Y) : L) = r) :
    IsLocalization.Away (matrixEntryDet (B := B) Y) (matrixGeneratedAlgebra (B := B) Y) := by
  apply subalgebra_isLocalization_away _ _ _ hmap
  · intro h
    exact hdet (congrArg Subtype.val h)
  · exact matrixGeneratedAlgebra_eq_adjoin_inverse Y

/-- The determinant-localization statement with the natural inclusion algebra. -/
theorem matrixGenerated_inclusion_isLocalization_away (Y : Matrix n n L)
    (hdet : Y.det ≠ 0) :
    letI : Algebra (matrixEntryAlgebra (B := B) Y) (matrixGeneratedAlgebra (B := B) Y) :=
      (Subalgebra.inclusion (matrixEntryAlgebra_le (B := B) Y)).toRingHom.toAlgebra
    IsLocalization.Away (matrixEntryDet (B := B) Y) (matrixGeneratedAlgebra (B := B) Y) := by
  exact subalgebra_inclusion_isLocalization_away
    (matrixEntryAlgebra (B := B) Y) (matrixGeneratedAlgebra (B := B) Y)
    (matrixEntryAlgebra_le Y) (matrixEntryDet Y)
    (fun h => hdet (congrArg Subtype.val h)) (matrixGeneratedAlgebra_eq_adjoin_inverse Y)

end StrictEUnit
