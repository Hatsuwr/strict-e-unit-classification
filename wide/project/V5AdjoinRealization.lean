import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.Algebra.Algebra.Subalgebra.Basic

noncomputable section
namespace StrictEUnit

variable {k P A C : Type*} [CommSemiring k] [CommSemiring P]
    [CommSemiring A] [CommSemiring C] [Algebra k P] [Algebra k A] [Algebra k C]

/-- If the generator images have preimages through an injective analytic
Taylor comparison, then the whole algebra generated by them has an algebraic
lift. No independent compatibility laws for the chosen generator preimages
are needed. -/
theorem v5_adjoin_realization (i : P →ₐ[k] C) (j : A →ₐ[k] C)
    (hj : Function.Injective j) (s : Set P)
    (hs : ∀ x ∈ s, ∃ a : A, j a = i x) :
    ∃ ρ : Algebra.adjoin k s →ₐ[k] A,
      j.comp ρ = i.comp (Algebra.adjoin k s).val ∧
      (Function.Injective i → Function.Injective ρ) := by
  have h (x : Algebra.adjoin k s) : i x.val ∈ j.range := by
    rcases x with ⟨x,hx⟩
    induction hx using Algebra.adjoin_induction with
    | mem x hx => exact hs x hx
    | algebraMap a =>
      rw [i.commutes]
      exact j.range.algebraMap_mem a
    | add a b _ _ ha hb =>
      change i (a + b) ∈ j.range
      rw [map_add i]
      exact j.range.add_mem ha hb
    | mul a b _ _ ha hb =>
      change i (a * b) ∈ j.range
      rw [map_mul i]
      exact j.range.mul_mem ha hb
  let e := AlgEquiv.ofInjective j hj
  let r := (i.comp (Algebra.adjoin k s).val).codRestrict j.range h
  let ρ := e.symm.toAlgHom.comp r
  have he (x : Algebra.adjoin k s) : j (ρ x) = i x.val := by
    change (e (e.symm (r x))).val = _
    rw [e.apply_symm_apply]
    rfl
  refine ⟨ρ, AlgHom.ext he, fun hi x y hxy => Subtype.ext (hi ?_)⟩
  rw [← he x, hxy, he y]

end StrictEUnit
#print axioms StrictEUnit.v5_adjoin_realization
